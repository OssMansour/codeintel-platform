# =============================================================================
# CodeIntel Platform — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# DO NOT commit .env to version control.
# All values here are either examples or safe defaults.
# =============================================================================

# === GITLAB ===
# URL of your self-hosted GitLab instance (no trailing slash)
GITLAB_URL=https://your-gitlab.internal.com
# Personal access token with api, read_repository, read_registry scopes
GITLAB_TOKEN=glpat-XXXXXXXXXXXXXXXXXXXX
# Secret used to verify incoming webhook HMAC signatures
GITLAB_WEBHOOK_SECRET=your-webhook-secret-here
# Default project to index (can be overridden per-request)
GITLAB_PROJECT_ID=group/repo-name

# === GITHUB ===
# URL of your GitHub instance (use https://github.com for github.com)
GITHUB_URL=https://github.com
# GitHub REST API base URL (use https://api.github.com for github.com)
GITHUB_API_URL=https://api.github.com
# Personal access token with repo scope
GITHUB_TOKEN=ghp_XXXXXXXXXXXXXXXXXXXX
# Default repository to index (owner/repo format)
GITHUB_REPO=owner/repo-name
# Secret used to verify incoming webhook HMAC-SHA256 signatures
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret-here

# === SCM PROVIDER ===
# Active source code management provider: gitlab or github
SCM_PROVIDER=gitlab

# === OLLAMA ===
# Base URL for the Ollama API (no trailing slash)
OLLAMA_BASE_URL=http://localhost:11434
# Number of CPU threads for Ollama inference (set to physical core count)
OLLAMA_NUM_THREADS=16
# Primary model for interactive queries (14B Q5_K_M recommended)
OLLAMA_PRIMARY_MODEL=qwen2.5-coder:14b-instruct-q5_K_M
# Fallback model when primary is under load or for fast queries
OLLAMA_FALLBACK_MODEL=qwen2.5-coder:7b-instruct-q4_K_M
# Batch model for overnight doc generation runs (slower, higher quality)
OLLAMA_BATCH_MODEL=qwen2.5-coder:32b-instruct-q4_K_M
# Context window size in tokens (reduce if running out of RAM)
OLLAMA_NUM_CTX=16384

# === QDRANT ===
# Base URL for the Qdrant REST API (no trailing slash)
QDRANT_URL=http://localhost:6333
# API key for Qdrant authentication (leave empty if no auth configured)
QDRANT_API_KEY=
# Collection names (do not change after initial indexing without re-indexing)
QDRANT_COLLECTION_CODE=code_repo
QDRANT_COLLECTION_APP_DOCS=app_docs
QDRANT_COLLECTION_INCIDENTS=incident_reports

# === REDIS / CELERY ===
# Redis URL for the Celery message broker
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
# Redis database 1 for Celery result backend (separate from broker)
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# === PATHS ===
# Base directory where GitLab repositories are cloned locally
REPO_CLONE_BASE=/data/repos
# Base directory for local indexes and caches
INDEX_BASE=/data/indexes
# Path to the Application_documentation.md file (always required)
APP_DOCS_PATH=/data/sources/Application_documentation.md
# Path to incident_reports.md (optional — omit or leave empty if not available)
INCIDENT_REPORTS_PATH=/data/sources/incident_reports.md

# === EMBEDDINGS ===
# HuggingFace model ID for the embedding model
EMBED_MODEL=nomic-ai/CodeRankEmbed
# Device for embeddings (cpu only — do not change to cuda)
EMBED_DEVICE=cpu
# Number of texts to embed per batch (reduce if OOM)
EMBED_BATCH_SIZE=32
# Directory to cache embedding model weights
EMBED_CACHE_DIR=/data/models/embed
# Directory to cache computed embeddings (file-based, indexed by content hash)
EMBED_VECTOR_CACHE_DIR=/data/indexes/embed_cache

# === RERANKER ===
# HuggingFace model ID for the cross-encoder reranker
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
# Directory to cache reranker model weights
RERANKER_CACHE_DIR=/data/models/reranker

# === SERVER ===
# Host to bind the FastAPI servers (0.0.0.0 for container)
HOST=0.0.0.0
# Port for the ingestion service
PORT=8000
# Port for the agent service
AGENT_PORT=8001
# Number of Gunicorn/Uvicorn worker processes
WORKERS=4
# Log level: debug, info, warning, error, critical
LOG_LEVEL=info
# Secret key for API authentication (change this in production!)
SECRET_KEY=change-me-in-production-generate-with-openssl-rand-hex-32

# === PARSING ===
# Languages to index (comma-separated; supported: python,javascript,typescript,go,java,c,cpp,csharp,kotlin,php)
PARSE_LANGUAGES=python,javascript,typescript,go,java,c,cpp,csharp,kotlin,php
# Maximum file size to parse in bytes (skip files larger than this)
PARSE_MAX_FILE_SIZE_BYTES=1048576
# Fallback chunk size for unsupported languages (in lines)
PARSE_FALLBACK_CHUNK_LINES=50

# === AGENT ===
# Maximum number of ReAct reasoning steps before forcing answer
AGENT_MAX_STEPS=10
# Top-k results to retrieve from each collection before reranking
AGENT_SEARCH_TOP_K=20
# Final top-k after cross-encoder reranking (context sent to LLM)
AGENT_RERANK_TOP_K=5
# SQLite path for LangGraph agent checkpointer
AGENT_CHECKPOINT_DB=/data/indexes/agent_checkpoints.db

# === DOC GENERATION ===
# Minimum interval between doc regeneration runs for the same project (seconds)
DOCGEN_COOLDOWN_SECONDS=300
# Maximum symbols to regenerate docs for in a single Celery task
DOCGEN_BATCH_SIZE=50
